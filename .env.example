# Copy to .env. Your Alpaca keys stay in this file on this machine; the app never stores them in the database.
# Leave the keys empty to explore the app on built-in demo data (no trading possible).
# Paper-trading keys: https://app.alpaca.markets (switch the dashboard to "Paper" first).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# "true" trades the paper account. Real money needs "false" here AND a typed confirmation in Settings.
ALPACA_PAPER=true

# "iex" works on the free plan; "sip" needs a paid data subscription.
ALPACA_DATA_FEED=iex

# SQLite file path, relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Keep everything local: disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
